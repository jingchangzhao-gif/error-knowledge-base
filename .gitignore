# Local isolated worktrees
.worktrees/

# Dependencies and build output
node_modules/
*.tsbuildinfo

# The DSH connector bundle is committed so the store can review a fixed source
# commit; its sourcemap stays local.
lib/*.map

# Coverage output from `vitest run --coverage`
coverage/

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local host-probe spill files. These are command transcripts, not fixtures.
*claude-probefired*.txt

# The errkb runtime knowledge base, all of it (§17 Q4). Real entries live in
# a private repository that `kbDir` points to; text-rule redaction cannot be
# complete, so a development install must never commit its errors/ here. The
# public repository only carries curated, redacted entries under seeds/.
errors/

# Go build output
/dist/
/errkb.exe

# Local PostgreSQL development data and dumps
/.pgdata/
*.dump

# Installer output
*.msi

# CUE module artifacts fetched from the registry; cue.mod/module.cue itself
# stays versioned
cue.mod/pkg/
cue.mod/usr/

# Local development configuration
.env
.env.local
.errkb.local.yml
